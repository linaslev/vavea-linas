# Netlify / Cloudflare Pages header rules.
# Harmless on other hosts — GitHub Pages just ignores this file.
#
# Calendar files must arrive as text/calendar, otherwise phones show the raw
# text instead of offering to add the event. Content-Disposition: attachment
# is what makes an in-app browser (Messenger, Instagram…) hand the file to the
# OS rather than trying to render it.
/assets/calendar/*
  Content-Type: text/calendar; charset=utf-8
  Content-Disposition: attachment
  Cache-Control: public, max-age=3600
